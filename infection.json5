{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    // The unit tests: the integration and E2E tests run the app in separate processes (no coverage, slow).
    "testFramework": "phpunit",
    // Composer may print deprecation notices instead of its bin-dir, so the path is explicit.
    "phpUnit": {
        "customPath": "vendor/bin/phpunit"
    },
    "testFrameworkOptions": "--testsuite=unit",
    "tmpDir": "var/infection",
    "logs": {
        "text": "var/infection/infection.log",
        "summary": "var/infection/summary.log"
    },
    // The rest are mostly equivalent mutants (e.g. NO_COLOR with a terminal is checked by the E2E tests).
    "minMsi": 90,
    "minCoveredMsi": 90,
    "mutators": {
        "@default": true,
        // The methods are protected on purpose: they are the extension points for the subclasses.
        "ProtectedVisibility": false
    }
}
