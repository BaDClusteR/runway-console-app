{
    "name": "bad_cluster/runway-console-app",
    "description": "Console applications for Runway: commands, input parsing, formatted output, tables, progress bars and interactive prompts.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "BaD ClusteR",
            "email": "admin@badcluster.ru"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-zip": "*",
        "bad_cluster/runway": "^2.0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "roave/security-advisories": "dev-latest",
        "phpstan/phpstan": "^2.3",
        "infection/infection": "^0.35"
    },
    "autoload": {
        "psr-4": {
            "Runway\\Console\\": "src/"
        },
        "files": [
            "bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Runway\\Console\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "phpstan": "phpstan --memory-limit=1G",
        "infection": "infection --threads=max"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
