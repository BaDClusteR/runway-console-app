{
    "name": "bad_cluster/runway-console-app",
    "version": "0.1.0",
    "type": "library",
    "authors": [
        {
            "name": "BaD ClusteR",
            "email": "admin@badcluster.ru"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-zip": "*",
        "bad_cluster/runway": "dev-main"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "Runway\\Console\\": "src/"
        },
        "files": [
            "bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Runway\\Console\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
